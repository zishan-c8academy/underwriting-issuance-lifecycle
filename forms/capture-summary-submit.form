{
  "components": [
    {
      "text": "## Summary and Submit to Issuer\nReview the entered information, then submit the completed record to the issuer.",
      "type": "text",
      "id": "t_sum_h"
    },
    {
      "label": "CUSIP",
      "type": "textfield",
      "key": "cusip",
      "id": "f_sum_cusip",
      "readonly": true
    },
    {
      "label": "Issuer Name",
      "type": "textfield",
      "key": "issuerName",
      "id": "f_sum_issuer",
      "readonly": true
    },
    {
      "label": "Closing Date",
      "type": "textfield",
      "key": "closingDate",
      "id": "f_sum_closing",
      "readonly": true
    },
    {
      "label": "Maturity Date",
      "type": "textfield",
      "key": "maturityDate",
      "id": "f_sum_maturity",
      "readonly": true
    },
    {
      "label": "Takedown Amount",
      "type": "number",
      "key": "takedownAmount",
      "id": "f_takedownAmount",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Issuer Contact Email",
      "type": "textfield",
      "key": "issuerContactEmail",
      "id": "f_issuerContactEmail",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Submit this offering record to the issuer",
      "type": "checkbox",
      "key": "submitToIssuer",
      "id": "f_submitToIssuer"
    }
  ],
  "type": "default",
  "id": "capture-summary-submit",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.7.0",
  "schemaVersion": 16
}
