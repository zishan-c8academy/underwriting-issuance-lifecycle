{
  "components": [
    {
      "text": "## Register Settlement Eligibility\nAll approvals are complete. Add the CUSIP to the security master to make it settlement eligible.",
      "type": "text",
      "id": "t_rs_h"
    },
    {
      "label": "CUSIP",
      "type": "textfield",
      "key": "cusip",
      "id": "f_rs_cusip",
      "readonly": true
    },
    {
      "label": "Issuer Name",
      "type": "textfield",
      "key": "issuerName",
      "id": "f_rs_issuer",
      "readonly": true
    },
    {
      "label": "Closing Date",
      "type": "textfield",
      "key": "closingDate",
      "id": "f_rs_closing",
      "readonly": true
    },
    {
      "label": "Security master record id",
      "type": "textfield",
      "key": "securityMasterRecordId",
      "id": "f_rs_record",
      "validate": {
        "required": true
      },
      "description": "Reference for the security master entry you created"
    },
    {
      "label": "Registration notes",
      "type": "textarea",
      "key": "registrationNotes",
      "id": "f_rs_notes"
    }
  ],
  "type": "default",
  "id": "register-settlement-eligibility",
