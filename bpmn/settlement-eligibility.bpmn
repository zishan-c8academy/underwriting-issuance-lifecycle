<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_SettlementEligibility" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.x" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collaboration_SettlementEligibility">
    <bpmn:participant id="Participant_SettlementEligibility" name="Settlement Eligibility" processRef="SettlementEligibility" />
  </bpmn:collaboration>

  <bpmn:process id="SettlementEligibility" name="Settlement Eligibility (approvals)" isExecutable="true">
    <bpmn:documentation>Approvals required for a security to achieve Settlement Eligibility. The issuer name and country are screened against the compliance list by a DMN decision; anything the rules cannot clear goes to a compliance officer. Legal and the Crediting Participant then approve in turn, and the security is registered on the security master. Every approval task is watched by a non-interrupting timer: if a task is overdue it raises an escalation that one shared event sub-process turns into a supervisor task, without disturbing the task itself.

The lanes show which team owns each step. Note that in Camunda 8 lanes are documentation only: the actual work assignment comes from each task's candidateGroups, which match the lane names.</bpmn:documentation>

    <bpmn:laneSet id="LaneSet_SettlementEligibility">
      <bpmn:lane id="Lane_Compliance" name="Compliance">
        <bpmn:flowNodeRef>Start_SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplianceScreening</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Disposition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplianceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ComplianceSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComplianceOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotEligible_Compliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinCompliance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="Legal">
        <bpmn:flowNodeRef>Task_LegalApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LegalSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LegalApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotEligible_Legal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CreditingParticipant" name="Crediting Participant">
        <bpmn:flowNodeRef>Task_CPApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CPSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CPApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotEligible_CP</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operations" name="Underwriting Operations">
        <bpmn:flowNodeRef>Task_RegisterSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RegisterSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Eligible</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>SubProcess_Escalation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_SE" name="Offering submitted">
      <bpmn:outgoing>Flow_s1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_s1" sourceRef="Start_SE" targetRef="Task_ComplianceScreening" />

    <bpmn:businessRuleTask id="Task_ComplianceScreening" name="Compliance screening (DMN)">
      <bpmn:documentation>Issuer Name and Country are scanned against the compliance file. The DMN returns a disposition of CLEAR or REVIEW plus a rationale, so the policy is owned by the business and editable without touching the model.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="compliance-screening" resultVariable="compliance" bindingType="latest" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_s1</bpmn:incoming>
      <bpmn:outgoing>Flow_s2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_s2" sourceRef="Task_ComplianceScreening" targetRef="Gateway_Disposition" />

    <bpmn:exclusiveGateway id="Gateway_Disposition" name="Compliance disposition?" default="Flow_review">
      <bpmn:incoming>Flow_s2</bpmn:incoming>
      <bpmn:outgoing>Flow_clear</bpmn:outgoing>
      <bpmn:outgoing>Flow_review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_clear" name="clear" sourceRef="Gateway_Disposition" targetRef="Gateway_JoinCompliance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=compliance.disposition = "CLEAR"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_review" name="review" sourceRef="Gateway_Disposition" targetRef="Task_ComplianceReview" />

    <bpmn:userTask id="Task_ComplianceReview" name="Compliance Review">
      <bpmn:documentation>A compliance officer adjudicates a screening hit the rules could not clear.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="compliance-review" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="compliance-officers" />
        <zeebe:priorityDefinition priority="70" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_review</bpmn:incoming>
      <bpmn:outgoing>Flow_s3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_ComplianceSLA" name="overdue" cancelActivity="false" attachedToRef="Task_ComplianceReview">
      <bpmn:outgoing>Flow_sla_compliance</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Compliance"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_sla_compliance" sourceRef="Boundary_ComplianceSLA" targetRef="End_ComplianceSLA" />
    <bpmn:endEvent id="End_ComplianceSLA" name="Escalate">
      <bpmn:incoming>Flow_sla_compliance</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EscDef_compliance" escalationRef="Escalation_TaskOverdue" />
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_s3" sourceRef="Task_ComplianceReview" targetRef="Gateway_ComplianceOutcome" />
    <bpmn:exclusiveGateway id="Gateway_ComplianceOutcome" name="Cleared?" default="Flow_comp_rejected">
      <bpmn:incoming>Flow_s3</bpmn:incoming>
      <bpmn:outgoing>Flow_comp_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_comp_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_comp_approved" name="approved" sourceRef="Gateway_ComplianceOutcome" targetRef="Gateway_JoinCompliance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=complianceDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_comp_rejected" name="rejected" sourceRef="Gateway_ComplianceOutcome" targetRef="End_NotEligible_Compliance" />
    <bpmn:endEvent id="End_NotEligible_Compliance" name="Not Settlement Eligible">
      <bpmn:incoming>Flow_comp_rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_JoinCompliance">
      <bpmn:incoming>Flow_clear</bpmn:incoming>
      <bpmn:incoming>Flow_comp_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_s4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_s4" sourceRef="Gateway_JoinCompliance" targetRef="Task_LegalApproval" />

    <bpmn:userTask id="Task_LegalApproval" name="Legal Approval">
      <bpmn:documentation>Legal review and approval of the offering.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="legal-approval" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="legal-counsel" />
        <zeebe:priorityDefinition priority="70" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_s4</bpmn:incoming>
      <bpmn:outgoing>Flow_s5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_LegalSLA" name="overdue" cancelActivity="false" attachedToRef="Task_LegalApproval">
      <bpmn:outgoing>Flow_sla_legal</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Legal"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_sla_legal" sourceRef="Boundary_LegalSLA" targetRef="End_LegalSLA" />
    <bpmn:endEvent id="End_LegalSLA" name="Escalate">
      <bpmn:incoming>Flow_sla_legal</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EscDef_legal" escalationRef="Escalation_TaskOverdue" />
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_s5" sourceRef="Task_LegalApproval" targetRef="Gateway_LegalApproved" />
    <bpmn:exclusiveGateway id="Gateway_LegalApproved" name="Legal approved?" default="Flow_legal_rejected">
      <bpmn:incoming>Flow_s5</bpmn:incoming>
      <bpmn:outgoing>Flow_legal_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_legal_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_legal_approved" name="approved" sourceRef="Gateway_LegalApproved" targetRef="Task_CPApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=legalDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_legal_rejected" name="rejected" sourceRef="Gateway_LegalApproved" targetRef="End_NotEligible_Legal" />
    <bpmn:endEvent id="End_NotEligible_Legal" name="Not Settlement Eligible">
      <bpmn:incoming>Flow_legal_rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_CPApproval" name="Crediting Participant Approval">
      <bpmn:documentation>The Crediting Participant approves the security. Pending keeps the task open by re-asking, matching the real-world wait for a participant response.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="crediting-participant-approval" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="crediting-participants" />
        <zeebe:priorityDefinition priority="60" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_legal_approved</bpmn:incoming>
      <bpmn:incoming>Flow_cp_pending</bpmn:incoming>
      <bpmn:outgoing>Flow_s6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_CPSLA" name="overdue" cancelActivity="false" attachedToRef="Task_CPApproval">
      <bpmn:outgoing>Flow_sla_cp</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_CP"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_sla_cp" sourceRef="Boundary_CPSLA" targetRef="End_CPSLA" />
    <bpmn:endEvent id="End_CPSLA" name="Escalate">
      <bpmn:incoming>Flow_sla_cp</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EscDef_cp" escalationRef="Escalation_TaskOverdue" />
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_s6" sourceRef="Task_CPApproval" targetRef="Gateway_CPApproved" />
    <bpmn:exclusiveGateway id="Gateway_CPApproved" name="CP approved?" default="Flow_cp_rejected">
      <bpmn:incoming>Flow_s6</bpmn:incoming>
      <bpmn:outgoing>Flow_cp_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_cp_pending</bpmn:outgoing>
      <bpmn:outgoing>Flow_cp_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_cp_approved" name="approved" sourceRef="Gateway_CPApproved" targetRef="Task_RegisterSE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cpDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_cp_pending" name="pending" sourceRef="Gateway_CPApproved" targetRef="Task_CPApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cpDecision = "PENDING"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_cp_rejected" name="rejected" sourceRef="Gateway_CPApproved" targetRef="End_NotEligible_CP" />
    <bpmn:endEvent id="End_NotEligible_CP" name="Not Settlement Eligible">
      <bpmn:incoming>Flow_cp_rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_RegisterSE" name="Register Settlement Eligibility (Security Master)">
      <bpmn:documentation>Settlement Eligibility is achieved: the CUSIP is officially added to the security master. Modeled as a human confirmation so the example runs with no custom code; point this at your security master system with a REST connector to automate it.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="register-settlement-eligibility" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="uw-operations" />
        <zeebe:priorityDefinition priority="60" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_cp_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_s7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_RegisterSLA" name="overdue" cancelActivity="false" attachedToRef="Task_RegisterSE">
      <bpmn:outgoing>Flow_sla_register</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Register"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_sla_register" sourceRef="Boundary_RegisterSLA" targetRef="End_RegisterSLA" />
    <bpmn:endEvent id="End_RegisterSLA" name="Escalate">
      <bpmn:incoming>Flow_sla_register</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EscDef_register" escalationRef="Escalation_TaskOverdue" />
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_s7" sourceRef="Task_RegisterSE" targetRef="End_Eligible" />
    <bpmn:endEvent id="End_Eligible" name="Settlement Eligible">
      <bpmn:incoming>Flow_s7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:subProcess id="SubProcess_Escalation" name="Overdue task escalation" triggeredByEvent="true">
      <bpmn:documentation>Non-interrupting escalation event sub-process. Every monitored task raises the same TASK_OVERDUE escalation, so the escalation logic lives here once instead of being copied next to each task. Non-interrupting means the original task stays open and workable while a supervisor is chased.</bpmn:documentation>
      <bpmn:startEvent id="Start_EscalationCaught" name="Task overdue" isInterrupting="false">
        <bpmn:outgoing>Flow_esc1</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="EscDef_catch" escalationRef="Escalation_TaskOverdue" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_esc1" sourceRef="Start_EscalationCaught" targetRef="Task_EscalationReview" />
      <bpmn:userTask id="Task_EscalationReview" name="Escalation Review">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="escalation-review" bindingType="latest" />
          <zeebe:assignmentDefinition candidateGroups="underwriting-supervisors" />
          <zeebe:priorityDefinition priority="90" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_esc1</bpmn:incoming>
        <bpmn:outgoing>Flow_esc2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_esc2" sourceRef="Task_EscalationReview" targetRef="End_EscalationHandled" />
      <bpmn:endEvent id="End_EscalationHandled" name="Escalation handled">
        <bpmn:incoming>Flow_esc2</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>

  <bpmn:escalation id="Escalation_TaskOverdue" name="Task overdue" escalationCode="TASK_OVERDUE" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_SettlementEligibility">
      <bpmndi:BPMNShape id="Participant_SettlementEligibility_di" bpmnElement="Participant_SettlementEligibility" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1560" height="1000" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Compliance_di" bpmnElement="Lane_Compliance" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1530" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Legal_di" bpmnElement="Lane_Legal" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="1530" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CreditingParticipant_di" bpmnElement="Lane_CreditingParticipant" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="1530" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Operations_di" bpmnElement="Lane_Operations" isHorizontal="true">
        <dc:Bounds x="190" y="680" width="1530" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true">
        <dc:Bounds x="190" y="880" width="1530" height="200" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_SE_di" bpmnElement="Start_SE">
        <dc:Bounds x="230" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="222" y="174" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ComplianceScreening_di" bpmnElement="Task_ComplianceScreening"><dc:Bounds x="310" y="110" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Disposition_di" bpmnElement="Gateway_Disposition" isMarkerVisible="true">
        <dc:Bounds x="500" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="482" y="182" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ComplianceReview_di" bpmnElement="Task_ComplianceReview"><dc:Bounds x="620" y="110" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_ComplianceSLA_di" bpmnElement="Boundary_ComplianceSLA">
        <dc:Bounds x="677" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="715" y="180" width="42" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ComplianceSLA_di" bpmnElement="End_ComplianceSLA">
        <dc:Bounds x="677" y="230" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="671" y="264" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ComplianceOutcome_di" bpmnElement="Gateway_ComplianceOutcome" isMarkerVisible="true">
        <dc:Bounds x="820" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="876" y="162" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NotEligible_Compliance_di" bpmnElement="End_NotEligible_Compliance">
        <dc:Bounds x="827" y="215" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="803" y="251" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinCompliance_di" bpmnElement="Gateway_JoinCompliance" isMarkerVisible="true">
        <dc:Bounds x="980" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_LegalApproval_di" bpmnElement="Task_LegalApproval"><dc:Bounds x="1030" y="310" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_LegalSLA_di" bpmnElement="Boundary_LegalSLA">
        <dc:Bounds x="1087" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1125" y="380" width="42" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LegalSLA_di" bpmnElement="End_LegalSLA">
        <dc:Bounds x="1087" y="430" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1081" y="464" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LegalApproved_di" bpmnElement="Gateway_LegalApproved" isMarkerVisible="true">
        <dc:Bounds x="1220" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1206" y="295" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NotEligible_Legal_di" bpmnElement="End_NotEligible_Legal">
        <dc:Bounds x="1227" y="415" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1203" y="453" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CPApproval_di" bpmnElement="Task_CPApproval"><dc:Bounds x="1020" y="510" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CPSLA_di" bpmnElement="Boundary_CPSLA">
        <dc:Bounds x="1102" y="572" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1140" y="580" width="42" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CPSLA_di" bpmnElement="End_CPSLA">
        <dc:Bounds x="1102" y="630" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1096" y="664" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
