<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_AgentConfirmation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.x" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:process id="AgentConfirmationEmail" name="Agent Confirmation Email" isExecutable="true">
    <bpmn:documentation>Security attribute confirmation, from client outreach through Masterfile update. UW Operations sends the agent a blank Security Attributes page with the CUSIP and Closing Date populated; the process then waits for the client to return it. An internal user compares the returned values against the closing documentation, and if they do not match, the Masterfile update and a Supervisor Review are both triggered.</bpmn:documentation>

    <bpmn:startEvent id="Start_AC" name="Confirmation needed">
      <bpmn:outgoing>Flow_a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_a1" sourceRef="Start_AC" targetRef="Task_SendEmail" />

    <bpmn:userTask id="Task_SendEmail" name="Send Confirmation Email">
      <bpmn:documentation>UW Operations sends the client a blank Security Attributes page with the CUSIP and Closing Date populated; First Payment Date, Maturity Date, Interest Rate and Payment Frequency are left blank for the client to confirm. Modeled as a human step so the example needs no mail account; swap in the official Email (SMTP) or SendGrid connector to send it automatically.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="send-confirmation-email" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="uw-operations" />
        <zeebe:priorityDefinition priority="50" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_a1</bpmn:incoming>
      <bpmn:outgoing>Flow_a2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_a2" sourceRef="Task_SendEmail" targetRef="Task_WaitClient" />

    <!-- ══════ Wait for the client's reply (message), with an overdue timer ══════ -->
    <bpmn:receiveTask id="Task_WaitClient" name="Wait for client response" messageRef="Message_ClientResponse">
      <bpmn:documentation>Waits for the client to return the completed Security Attributes page. This is a real message catch correlated on the CUSIP, so any channel that can publish a message (an inbound connector, an API call from your mail or portal integration, or the helper script in scripts/) resumes the process. A receive task is used rather than a plain catch event so an overdue timer can be attached to it.</bpmn:documentation>
      <bpmn:incoming>Flow_a2</bpmn:incoming>
      <bpmn:outgoing>Flow_a3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_ClientSLA" name="overdue" cancelActivity="false" attachedToRef="Task_WaitClient">
      <bpmn:outgoing>Flow_sla_client</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Client"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_sla_client" sourceRef="Boundary_ClientSLA" targetRef="End_ClientSLA" />
    <bpmn:endEvent id="End_ClientSLA" name="Escalate">
      <bpmn:incoming>Flow_sla_client</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EscDef_client" escalationRef="Escalation_TaskOverdue" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_a3" sourceRef="Task_WaitClient" targetRef="Task_CompareDocs" />

    <!-- ══════ Internal comparison against closing documentation ══════ -->
    <bpmn:userTask id="Task_CompareDocs" name="Compare to Closing Docs">
      <bpmn:documentation>An internal user compares the client's submission against the closing documentation and records whether the values match.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="compare-to-closing-docs" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="uw-operations" />
        <zeebe:priorityDefinition priority="70" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_a3</bpmn:incoming>
      <bpmn:outgoing>Flow_a4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_CompareSLA" name="overdue" cancelActivity="false" attachedToRef="Task_CompareDocs">
      <bpmn:outgoing>Flow_sla_compare</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Compare"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_sla_compare" sourceRef="Boundary_CompareSLA" targetRef="End_CompareSLA" />
    <bpmn:endEvent id="End_CompareSLA" name="Escalate">
      <bpmn:incoming>Flow_sla_compare</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EscDef_compare" escalationRef="Escalation_TaskOverdue" />
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_a4" sourceRef="Task_CompareDocs" targetRef="Gateway_ValuesMatch" />
    <bpmn:exclusiveGateway id="Gateway_ValuesMatch" name="Values match?" default="Flow_mismatch">
      <bpmn:incoming>Flow_a4</bpmn:incoming>
      <bpmn:outgoing>Flow_match</bpmn:outgoing>
      <bpmn:outgoing>Flow_mismatch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_match" name="match" sourceRef="Gateway_ValuesMatch" targetRef="End_NoCorrection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valuesMatch = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_mismatch" name="mismatch" sourceRef="Gateway_ValuesMatch" targetRef="Gateway_CorrectionSplit" />

    <!-- ══════ Mismatch: Masterfile update AND Supervisor Review are both triggered ══════ -->
    <bpmn:parallelGateway id="Gateway_CorrectionSplit" name="Correct and review">
      <bpmn:incoming>Flow_mismatch</bpmn:incoming>
      <bpmn:outgoing>Flow_split_update</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_super</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_split_update" sourceRef="Gateway_CorrectionSplit" targetRef="Task_UpdateMasterfile" />
    <bpmn:sequenceFlow id="Flow_split_super" sourceRef="Gateway_CorrectionSplit" targetRef="Task_SupervisorReview" />

    <bpmn:userTask id="Task_UpdateMasterfile" name="Update Masterfile">
      <bpmn:documentation>If the recorded values do not match the client-confirmed values and closing documentation, update the applicable security attributes in the Masterfile.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="update-masterfile" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="uw-operations" />
        <zeebe:priorityDefinition priority="80" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_split_update</bpmn:incoming>
      <bpmn:outgoing>Flow_update_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_update_join" sourceRef="Task_UpdateMasterfile" targetRef="Gateway_CorrectionJoin" />

    <bpmn:userTask id="Task_SupervisorReview" name="Supervisor Review">
      <bpmn:documentation>A supervisor reviews the discrepancy that triggered the correction.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="supervisor-review" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="underwriting-supervisors" />
        <zeebe:priorityDefinition priority="80" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_split_super</bpmn:incoming>
      <bpmn:outgoing>Flow_super_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_super_join" sourceRef="Task_SupervisorReview" targetRef="Gateway_CorrectionJoin" />

    <bpmn:parallelGateway id="Gateway_CorrectionJoin">
      <bpmn:incoming>Flow_update_join</bpmn:incoming>
      <bpmn:incoming>Flow_super_join</bpmn:incoming>
      <bpmn:outgoing>Flow_a5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_a5" sourceRef="Gateway_CorrectionJoin" targetRef="End_Corrected" />

    <bpmn:endEvent id="End_Corrected" name="Corrected in Masterfile">
      <bpmn:incoming>Flow_a5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NoCorrection" name="Confirmed, no correction">
      <bpmn:incoming>Flow_match</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ══════ One shared escalation handler for every overdue task ══════ -->
    <bpmn:subProcess id="SubProcess_Escalation" name="Overdue task escalation" triggeredByEvent="true">
      <bpmn:documentation>Non-interrupting escalation event sub-process. The client-response wait and the comparison task both raise the same TASK_OVERDUE escalation, handled here once. Non-interrupting means the original task or message wait continues while it is chased.</bpmn:documentation>
      <bpmn:startEvent id="Start_EscalationCaught" name="Task overdue" isInterrupting="false">
        <bpmn:outgoing>Flow_esc1</bpmn:outgoing>
        <bpmn:escalationEventDefinition id="EscDef_catch" escalationRef="Escalation_TaskOverdue" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_esc1" sourceRef="Start_EscalationCaught" targetRef="Task_EscalationReview" />
      <bpmn:userTask id="Task_EscalationReview" name="Escalation Review">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="escalation-review" bindingType="latest" />
          <zeebe:assignmentDefinition candidateGroups="underwriting-supervisors" />
          <zeebe:priorityDefinition priority="90" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_esc1</bpmn:incoming>
        <bpmn:outgoing>Flow_esc2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_esc2" sourceRef="Task_EscalationReview" targetRef="End_EscalationHandled" />
      <bpmn:endEvent id="End_EscalationHandled" name="Escalation handled">
        <bpmn:incoming>Flow_esc2</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>

  <bpmn:message id="Message_ClientResponse" name="ClientSecurityAttributesReturned">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=cusip" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:escalation id="Escalation_TaskOverdue" name="Task overdue" escalationCode="TASK_OVERDUE" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="AgentConfirmationEmail">
      <bpmndi:BPMNShape id="Start_AC_di" bpmnElement="Start_AC">
        <dc:Bounds x="162" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="140" y="225" width="82" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendEmail_di" bpmnElement="Task_SendEmail"><dc:Bounds x="250" y="160" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WaitClient_di" bpmnElement="Task_WaitClient"><dc:Bounds x="470" y="160" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CompareDocs_di" bpmnElement="Task_CompareDocs"><dc:Bounds x="690" y="160" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValuesMatch_di" bpmnElement="Gateway_ValuesMatch" isMarkerVisible="true">
        <dc:Bounds x="910" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="898" y="132" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NoCorrection_di" bpmnElement="End_NoCorrection">
        <dc:Bounds x="1020" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="998" y="225" width="82" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CorrectionSplit_di" bpmnElement="Gateway_CorrectionSplit">
        <dc:Bounds x="910" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="896" y="371" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateMasterfile_di" bpmnElement="Task_UpdateMasterfile"><dc:Bounds x="1020" y="260" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SupervisorReview_di" bpmnElement="Task_SupervisorReview"><dc:Bounds x="1020" y="380" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CorrectionJoin_di" bpmnElement="Gateway_CorrectionJoin">
        <dc:Bounds x="1240" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Corrected_di" bpmnElement="End_Corrected">
        <dc:Bounds x="1340" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1316" y="365" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Boundary_ClientSLA_di" bpmnElement="Boundary_ClientSLA">
        <dc:Bounds x="527" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="565" y="232" width="42" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ClientSLA_di" bpmnElement="End_ClientSLA">
        <dc:Bounds x="527" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="521" y="495" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CompareSLA_di" bpmnElement="Boundary_CompareSLA">
        <dc:Bounds x="747" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="785" y="232" width="42" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CompareSLA_di" bpmnElement="End_CompareSLA">
        <dc:Bounds x="747" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="741" y="495" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SubProcess_Escalation_di" bpmnElement="SubProcess_Escalation" isExpanded="true">
        <dc:Bounds x="250" y="560" width="560" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_EscalationCaught_di" bpmnElement="Start_EscalationCaught">
        <dc:Bounds x="290" y="630" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="280" y="673" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EscalationReview_di" bpmnElement="Task_EscalationReview"><dc:Bounds x="370" y="608" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_EscalationHandled_di" bpmnElement="End_EscalationHandled">
        <dc:Bounds x="580" y="630" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="560" y="673" width="78" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_a1_di" bpmnElement="Flow_a1"><di:waypoint x="198" y="200" /><di:waypoint x="250" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_a2_di" bpmnElement="Flow_a2"><di:waypoint x="420" y="200" /><di:waypoint x="470" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_a3_di" bpmnElement="Flow_a3"><di:waypoint x="640" y="200" /><di:waypoint x="690" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_a4_di" bpmnElement="Flow_a4"><di:waypoint x="860" y="200" /><di:waypoint x="910" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_match_di" bpmnElement="Flow_match">
        <di:waypoint x="960" y="200" /><di:waypoint x="1020" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="966" y="182" width="38" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_mismatch_di" bpmnElement="Flow_mismatch">
        <di:waypoint x="935" y="225" /><di:waypoint x="935" y="315" />
        <bpmndi:BPMNLabel><dc:Bounds x="941" y="262" width="52" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_split_update_di" bpmnElement="Flow_split_update">
        <di:waypoint x="960" y="340" /><di:waypoint x="990" y="340" /><di:waypoint x="990" y="300" /><di:waypoint x="1020" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_split_super_di" bpmnElement="Flow_split_super">
        <di:waypoint x="960" y="340" /><di:waypoint x="990" y="340" /><di:waypoint x="990" y="420" /><di:waypoint x="1020" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_update_join_di" bpmnElement="Flow_update_join">
        <di:waypoint x="1190" y="300" /><di:waypoint x="1215" y="300" /><di:waypoint x="1215" y="340" /><di:waypoint x="1240" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_super_join_di" bpmnElement="Flow_super_join">
        <di:waypoint x="1190" y="420" /><di:waypoint x="1215" y="420" /><di:waypoint x="1215" y="340" /><di:waypoint x="1240" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_a5_di" bpmnElement="Flow_a5"><di:waypoint x="1290" y="340" /><di:waypoint x="1340" y="340" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_sla_client_di" bpmnElement="Flow_sla_client"><di:waypoint x="545" y="258" /><di:waypoint x="545" y="452" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_sla_compare_di" bpmnElement="Flow_sla_compare"><di:waypoint x="765" y="258" /><di:waypoint x="765" y="452" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_esc1_di" bpmnElement="Flow_esc1"><di:waypoint x="326" y="648" /><di:waypoint x="370" y="648" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_esc2_di" bpmnElement="Flow_esc2"><di:waypoint x="530" y="648" /><di:waypoint x="580" y="648" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
