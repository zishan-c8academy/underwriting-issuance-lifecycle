<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OfferingCapture" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.x" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:process id="OfferingCapture" name="offering capture (capture offering and security)" isExecutable="true">
    <bpmn:documentation>offering capture: a five-step sequence from security identification through issuer submission. Every step is a Camunda user task with a form, so the sequence and the fields live in the model rather than in front-end code. Worked by the UW Analyst queue.</bpmn:documentation>

    <bpmn:startEvent id="Start_Capture" name="Start Offering Capture">
      <bpmn:outgoing>Flow_e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_e1" sourceRef="Start_Capture" targetRef="Task_EnterCusip" />

    <bpmn:userTask id="Task_EnterCusip" name="Enter CUSIP">
      <bpmn:documentation>Input the CUSIP to identify the security.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="capture-enter-cusip" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="uw-analysts" />
        <zeebe:priorityDefinition priority="50" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_e1</bpmn:incoming>
      <bpmn:outgoing>Flow_e2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_e2" sourceRef="Task_EnterCusip" targetRef="Task_OfferingInfo" />

    <bpmn:userTask id="Task_OfferingInfo" name="Offering Info">
      <bpmn:documentation>Capture offering-level details: Base CUSIP, Issuer Name, Issuer Country, Closing Date, Paying Agent, Brokerage Agreement Date.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="capture-offering-info" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="uw-analysts" />
        <zeebe:priorityDefinition priority="50" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_e2</bpmn:incoming>
      <bpmn:outgoing>Flow_e3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_e3" sourceRef="Task_OfferingInfo" targetRef="Task_SecurityInfo" />

    <bpmn:userTask id="Task_SecurityInfo" name="Security Info">
      <bpmn:documentation>Confirm security-level attributes: Security Takedown, Dated Date, First Payment Date, Maturity Date, Interest Type, Interest Start, Interest End, Interest Rate, Payment Frequency.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="capture-security-info" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="uw-analysts" />
        <zeebe:priorityDefinition priority="50" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_e3</bpmn:incoming>
      <bpmn:outgoing>Flow_e4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_e4" sourceRef="Task_SecurityInfo" targetRef="Task_SummarySubmit" />

    <bpmn:userTask id="Task_SummarySubmit" name="Summary and Submit to Issuer">
      <bpmn:documentation>Review the entered information, then submit the completed offering record to the issuer. The source process names Summary and Submit to Issuer as two steps; they are one review-and-confirm screen here because the submission is the act of completing the review. Split them if you want them tracked as separate audit events.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="capture-summary-submit" bindingType="latest" />
        <zeebe:assignmentDefinition candidateGroups="uw-analysts" />
        <zeebe:priorityDefinition priority="60" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_e4</bpmn:incoming>
      <bpmn:outgoing>Flow_e5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_e5" sourceRef="Task_SummarySubmit" targetRef="End_Capture" />

    <bpmn:endEvent id="End_Capture" name="Submitted to issuer">
      <bpmn:incoming>Flow_e5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="OfferingCapture">
      <bpmndi:BPMNShape id="Start_Capture_di" bpmnElement="Start_Capture">
        <dc:Bounds x="162" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="154" y="225" width="54" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterCusip_di" bpmnElement="Task_EnterCusip"><dc:Bounds x="250" y="160" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OfferingInfo_di" bpmnElement="Task_OfferingInfo"><dc:Bounds x="440" y="160" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SecurityInfo_di" bpmnElement="Task_SecurityInfo"><dc:Bounds x="630" y="160" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SummarySubmit_di" bpmnElement="Task_SummarySubmit"><dc:Bounds x="820" y="160" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Capture_di" bpmnElement="End_Capture">
        <dc:Bounds x="1042" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1022" y="225" width="78" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_e1_di" bpmnElement="Flow_e1"><di:waypoint x="198" y="200" /><di:waypoint x="250" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_e2_di" bpmnElement="Flow_e2"><di:waypoint x="390" y="200" /><di:waypoint x="440" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_e3_di" bpmnElement="Flow_e3"><di:waypoint x="580" y="200" /><di:waypoint x="630" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_e4_di" bpmnElement="Flow_e4"><di:waypoint x="770" y="200" /><di:waypoint x="820" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_e5_di" bpmnElement="Flow_e5"><di:waypoint x="990" y="200" /><di:waypoint x="1042" y="200" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
