# This example needs NO secrets to run locally.
#
# The only setting you may need is how the helper script authenticates against your
# local Camunda 8 Run REST API when it publishes the client-response message
# (scripts/simulate-client-response.sh).
#
# Camunda 8 Run's default local user is demo/demo. If you disabled auth, set C8_AUTH to
# an empty string. If you run against a secured cluster, use its own credentials.

C8_REST_BASE=http://localhost:8080
C8_AUTH=demo:demo
